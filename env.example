# Поле birth_date в таблице people теперь nullable (необязательное)
# Новые поля people: is_active (boolean), about (text) - переменные окружения не требуются

# API настройки
APP_NAME="SportRep API"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://p.sportrep.ru

# Настройки памяти для PHP
# memory_limit=1024M
# max_execution_time=300
# max_input_time=300

# База данных
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sportrep
DB_USERNAME=root
DB_PASSWORD=

# Логирование
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Кэширование
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Настройки для API
API_RATE_LIMIT=60
API_RATE_LIMIT_WINDOW=60

# Настройки для загрузки файлов
UPLOAD_MAX_FILESIZE=20M
POST_MAX_SIZE=20M
